/* 时空交集 - Dark Tech Theme */

page {
  background: #0a0e1a;
}

.page.dark-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0a0e1a;
  color: #e0e6f0;
}

/* ===== 顶部信息栏 ===== */
.dark-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: rgba(10,14,26,0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  z-index: 100;
  border-bottom: 1rpx solid rgba(0,255,204,0.1);
}

.bar-left {
  display: flex;
  flex-direction: column;
}

.bar-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #00ffcc;
  text-shadow: 0 0 12rpx rgba(0,255,204,0.5);
}

.bar-subtitle {
  font-size: 18rpx;
  color: rgba(0,255,204,0.4);
  letter-spacing: 2rpx;
}

.dark-btn {
  padding: 8rpx 20rpx;
  background: rgba(0,255,204,0.1);
  border: 1rpx solid rgba(0,255,204,0.3);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #00ffcc;
  font-weight: 500;
}

.dark-btn:active {
  background: rgba(0,255,204,0.2);
}

/* ===== 统计横幅 ===== */
.stats-banner {
  position: absolute;
  top: 88rpx;
  left: 0;
  right: 0;
  height: 120rpx;
  background: rgba(10,14,26,0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: space-around;
  z-index: 99;
  border-bottom: 1rpx solid rgba(0,255,204,0.08);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-num.glow {
  font-size: 40rpx;
  font-weight: 800;
  color: #00ffcc;
  text-shadow: 0 0 16rpx rgba(0,255,204,0.6);
  line-height: 1;
}

.stat-num.glow-sm {
  font-size: 32rpx;
  font-weight: 700;
  color: #00ffcc;
  text-shadow: 0 0 12rpx rgba(0,255,204,0.4);
  line-height: 1;
}

.stat-label {
  font-size: 20rpx;
  color: rgba(224,230,240,0.5);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: linear-gradient(180deg, transparent, rgba(0,255,204,0.2), transparent);
}

/* ===== 地图容器 ===== */
.map-container {
  flex: 1;
  width: 100%;
  height: 100%;
  position: relative;
}

.dark-map {
  width: 100%;
  height: 100%;
}

/* 暗色覆盖层 */
.map-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(5,8,18,0.55);
  pointer-events: none;
  z-index: 1;
}

/* ===== 交集列表视图 ===== */
.intersections-scroll {
  flex: 1;
  width: 100%;
  padding: 0 20rpx 140rpx;
  padding-top: 218rpx;
}

.inter-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: rgba(20,26,46,0.8);
  border: 1rpx solid rgba(0,255,204,0.1);
  border-radius: 20rpx;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  animation: cardEnter 0.4s ease;
  transition: all 0.2s ease;
}

.inter-card:active {
  transform: scale(0.98);
  border-color: rgba(0,255,204,0.3);
  box-shadow: 0 0 24rpx rgba(0,255,204,0.1);
}

.inter-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 2rpx solid;
  position: relative;
}

.dot-pulse {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  animation: pulse 2s ease infinite;
}

.inter-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.inter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.inter-place {
  font-size: 30rpx;
  font-weight: 700;
  color: #e0e6f0;
}

.inter-count {
  font-size: 26rpx;
  font-weight: 700;
}

.inter-message {
  font-size: 24rpx;
  color: rgba(224,230,240,0.6);
  line-height: 1.5;
}

.inter-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}

.inter-time {
  font-size: 20rpx;
  color: rgba(0,255,204,0.5);
  font-weight: 500;
}

.inter-cat {
  font-size: 20rpx;
  color: rgba(224,230,240,0.3);
  padding: 4rpx 12rpx;
  border: 1rpx solid rgba(224,230,240,0.15);
  border-radius: 8rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  animation: float 3s ease-in-out infinite;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(224,230,240,0.6);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: rgba(224,230,240,0.3);
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

/* ===== 详情卡片（暗色） ===== */
.detail-card.dark-card {
  position: fixed;
  bottom: 110rpx;
  left: 0;
  right: 0;
  z-index: 200;
  padding: 0 28rpx;
}

.dark-card-content {
  background: rgba(15,20,36,0.95);
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx;
  box-shadow: 0 -4rpx 32rpx rgba(0,0,0,0.4), 0 0 24rpx rgba(0,255,204,0.08);
  border-top: 1rpx solid rgba(0,255,204,0.15);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(100%); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes cardEnter {
  from { opacity: 0; transform: translateY(24rpx) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.dark-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #e0e6f0;
}

.dark-desc {
  font-size: 26rpx;
  color: rgba(224,230,240,0.6);
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: block;
}

.dark-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: rgba(224,230,240,0.4);
}

.card-tag {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.glow-tag {
  border: 1rpx solid;
}

.inter-info-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: rgba(0,255,204,0.04);
  border: 1rpx solid rgba(0,255,204,0.08);
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.inter-info-label {
  font-size: 24rpx;
  color: rgba(224,230,240,0.5);
}

.inter-info-count {
  font-size: 32rpx;
  font-weight: 800;
  flex: 1;
  text-align: center;
}

.inter-info-time {
  font-size: 22rpx;
  color: rgba(0,255,204,0.6);
}

.btn-navigate {
  background: linear-gradient(135deg, #2E7D32, #4CAF50);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-navigate::after { border: none; }

.dark-nav-btn {
  background: linear-gradient(135deg, #00b894, #00ffcc) !important;
  color: #0a0e1a !important;
  font-weight: 700 !important;
  border: none !important;
  border-radius: 48rpx !important;
  font-size: 28rpx !important;
  padding: 20rpx 0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 12rpx !important;
  box-shadow: 0 4rpx 20rpx rgba(0,255,204,0.3) !important;
}

.nav-icon-img {
  width: 36rpx;
  height: 36rpx;
}

/* ===== 底部标记点 ===== */
.dark-chips {
  position: absolute;
  bottom: 110rpx;
  left: 0;
  right: 0;
  height: 64rpx;
  white-space: nowrap;
  padding: 0 20rpx;
  z-index: 50;
  background: transparent;
}

.dark-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  background: rgba(20,26,46,0.85);
  border: 1rpx solid;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #e0e6f0;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.chip-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* ===== 动画 ===== */
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(1.5); }
}
