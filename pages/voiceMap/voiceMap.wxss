.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F5F5;
}

/* 顶部 */
.top-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.top-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C2C2C;
}

.action-btn {
  padding: 8rpx 20rpx;
  background: #F3E5F5;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #7B1FA2;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.action-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 地图 */
.map {
  flex: 1;
  width: 100%;
  height: 100vh;
}

/* 空状态提示 */
.empty-tip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 26rpx;
  color: #999;
  z-index: 10;
  pointer-events: none;
}

/* 底部语音列表 */
.voice-list {
  position: absolute;
  bottom: 110rpx;
  left: 0;
  right: 0;
  max-height: 400rpx;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 20rpx 28rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 50;
}

.voice-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.voice-item:last-child { border-bottom: none; }

.voice-left {
  flex: 1;
  overflow: hidden;
}

.voice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2C;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.voice-location {
  font-size: 22rpx;
  color: #999;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 4rpx;
}

.voice-author {
  font-size: 22rpx;
  color: #BBB;
  display: block;
  margin-top: 2rpx;
}

.voice-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.play-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F3E5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.play-btn.playing {
  background: #7B1FA2;
  color: #fff;
}

.voice-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #C62828;
}

/* 录音面板 */
.record-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 300;
}

.panel-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.panel-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx;
  animation: slideUpPanel 0.3s ease;
}

@keyframes slideUpPanel {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
}

.panel-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999;
}

/* 编辑模式 */
.edit-section .form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 8rpx;
  display: block;
}

.form-input {
  background: #F5F5F5;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.record-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: #E8F5E9;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: #2E7D32;
}

.status-dot {
  color: #4CAF50;
  animation: pulse 1s infinite;
}

.btn-save {
  background: linear-gradient(135deg, #7B1FA2, #BA68C8);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
}

.btn-save::after { border: none; }

/* 录音模式 */
.record-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.location-bar {
  width: 100%;
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
}

.location-icon { font-size: 32rpx; margin-right: 12rpx; }

.location-text {
  font-size: 26rpx;
  color: #666;
}

.record-circle {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7B1FA2, #BA68C8);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(123, 31, 162, 0.3);
  margin-bottom: 24rpx;
}

.record-circle.recording {
  animation: pulse 1s infinite;
  background: linear-gradient(135deg, #C62828, #EF5350);
  box-shadow: 0 8rpx 32rpx rgba(198, 40, 40, 0.3);
}

.circle-inner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  margin-bottom: 12rpx;
}

.record-circle.recording .circle-inner {
  background: #fff;
}

.record-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.record-time {
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
  margin-top: 4rpx;
}

.record-tip {
  font-size: 22rpx;
  color: #999;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
