.container {
  padding: 32rpx;
}

.header {
  margin-bottom: 32rpx;
}

.type-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.tag-green {
  background: #E8F5E9;
  color: #2E7D32;
}

.tag-blue {
  background: #E3F2FD;
  color: #1565C0;
}

.tag-gold {
  background: #FFF3E0;
  color: #F57C00;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.meta {
  display: flex;
  gap: 24rpx;
  font-size: 26rpx;
  color: #666;
}

.info-section {
  background: #F5F5F5;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.info-item {
  display: flex;
  margin-bottom: 12rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.label {
  color: #666;
  font-size: 28rpx;
}

.value {
  font-size: 28rpx;
  flex: 1;
}

.content-section {
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
}

.content {
  font-size: 30rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.empty {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #999;
}
