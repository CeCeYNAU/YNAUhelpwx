.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.page-header {
  background: linear-gradient(135deg, #00796B 0%, #009688 50%, #4DB6AC 100%);
  padding: 48rpx 28rpx 24rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

/* Abstract geometric background overlay */
.page-header::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url('/images/ui-images/土包楼.png');
  background-size: cover;
  background-position: center;
  opacity: 0.12;
  z-index: 0;
  animation: bgZoom 25s ease-in-out infinite alternate-reverse;
}

@keyframes bgZoom {
  from { transform: scale(1); }
  to { transform: scale(1.08); }
}

.page-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  position: relative;
  z-index: 1;
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 4rpx;
}

/* 上传按钮 */
.publish-btn {
  margin: 20rpx 28rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #00796B, #4DB6AC);
  border-radius: 20rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(0,121,107,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: transform 0.2s;
}

.publish-btn:active { transform: scale(0.96); }

.publish-icon-emoji {
  font-size: 40rpx;
  line-height: 1;
}

/* 空状态 - 添加动画 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  animation: fadeIn 0.6s ease;
}

.empty-icon-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
  animation: float 3s ease-in-out infinite;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 照片网格 - 瀑布流两列 */
.photo-grid {
  column-count: 2;
  column-gap: 16rpx;
  padding: 0 20rpx;
}

.photo-card {
  break-inside: avoid;
  margin-bottom: 16rpx;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(255,255,255,0.5);
  transition: all 0.3s ease;
  animation: cardEnter 0.4s ease;
}

.photo-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.photo-img {
  width: 100%;
  display: block;
}

.photo-info {
  padding: 16rpx;
}

.photo-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2C2C2C;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.photo-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
}

.photo-author {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo-delete {
  color: #C62828;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #FFEBEE;
  transition: all 0.2s;
}

.photo-delete:active {
  background: #C62828;
  color: #fff;
}
