.todo-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  position: relative;
}

.page-header {
  background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 40%, #43A047 70%, #66BB6A 100%);
  color: #fff;
  padding: 48rpx 28rpx 36rpx;
  position: relative;
  overflow: hidden;
}

/* Abstract geometric background overlay */
.page-header::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url('/images/ui-images/校友会堂.png');
  background-size: cover;
  background-position: center;
  opacity: 0.15;
  z-index: 0;
  animation: bgZoom 26s ease-in-out infinite alternate;
}

@keyframes bgZoom {
  from { transform: scale(1); }
  to { transform: scale(1.08); }
}

.page-title { font-size: 40rpx; font-weight: 800; color: #fff; position: relative; z-index: 1; }
.page-subtitle { font-size: 24rpx; color: rgba(255,255,255,0.75); margin-top: 6rpx; display: block; position: relative; z-index: 1; }

.filter-bar { display: flex; gap: 16rpx; padding: 24rpx 28rpx; }

.filter {
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: var(--ink-light);
  background: rgba(255,255,255,0.8);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  font-weight: 500;
  transition: all 0.2s;
}

.filter:active { transform: scale(0.95); }
.filter.active { background: var(--green); color: #fff; font-weight: 600; }

.list-scroll { height: calc(100vh - 300rpx); }
.list-wrap { padding: 0 28rpx; }

.todo-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 1rpx solid rgba(255,255,255,0.5);
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}

.todo-item:active { background: var(--paper); }

/* 紧急任务红色脉冲边框 */
.todo-item.urgent {
  border: 2rpx solid var(--error);
  animation: urgentPulse 2s ease-in-out infinite;
}

@keyframes urgentPulse {
  0%, 100% { border-color: rgba(244,67,54,0.3); box-shadow: 0 0 0 0 rgba(244,67,54,0.1); }
  50% { border-color: rgba(244,67,54,0.8); box-shadow: 0 0 0 6rpx rgba(244,67,54,0.05); }
}

.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--green);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s;
}

.check.checked {
  background: var(--green);
  border-color: var(--green);
}

.check text { font-size: 24rpx; color: #fff; font-weight: 700; }

.todo-info { flex: 1; }

.todo-title {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
  display: block;
}

.todo-title.completed {
  text-decoration: line-through;
  color: var(--gray);
}

.todo-meta {
  font-size: 22rpx;
  color: var(--gray);
  display: block;
  margin-top: 6rpx;
}

/* 优先级印章样式 */
.priority-stamp {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
  margin-left: 12rpx;
}

.priority-stamp.urgent {
  background: var(--error);
  color: #fff;
}

.priority-stamp.normal {
  background: var(--green-bg);
  color: var(--green);
}

.delete-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #FFEBEE;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s;
}

.delete-btn:active {
  background: var(--red);
}

.delete-btn:active text { color: #fff; }

.delete-btn text { font-size: 28rpx; color: var(--red); font-weight: 700; }

.add-btn {
  position: fixed;
  bottom: 120rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--green), var(--green-light));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(46,125,50,0.35);
  z-index: 10;
  transition: transform 0.2s;
}

.add-btn text { font-size: 48rpx; color: #fff; font-weight: 300; }
.add-btn:active { transform: scale(0.9); }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  animation: fadeIn 0.5s ease;
}

.empty-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 26rpx; color: var(--gray); }
