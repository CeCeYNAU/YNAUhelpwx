<view class="page">
  <view class="page-header">
    <text class="page-title">分享资料</text>
    <text class="page-subtitle">与同学共享学习资源</text>
  </view>

  <view class="form-container">
    <view class="form-section">
      <text class="section-label">标题</text>
      <input class="form-input" placeholder="请输入资料标题" value="{{title}}" bindinput="onTitleInput" maxlength="30" />
      <text class="char-count">{{title.length}}/30</text>
    </view>

    <view class="form-section">
      <text class="section-label">类型</text>
      <picker mode="selector" range="{{types}}" bindchange="onTypeChange">
        <view class="form-picker">{{type}}</view>
      </picker>
    </view>

    <view class="form-section">
      <text class="section-label">课程名（选填）</text>
      <input class="form-input" placeholder="如：高等数学" value="{{course}}" bindinput="onCourseInput" />
    </view>

    <view class="form-section">
      <text class="section-label">教师（选填）</text>
      <input class="form-input" placeholder="如：张教授" value="{{teacher}}" bindinput="onTeacherInput" />
    </view>

    <view class="form-section">
      <text class="section-label">内容</text>
      <textarea class="form-textarea" placeholder="分享你的笔记、资料或评价...（至少10字）" value="{{content}}" bindinput="onContentInput" maxlength="1000" auto-height />
      <text class="char-count">{{content.length}}/1000</text>
    </view>

    <button class="btn-submit" bindtap="doSubmit" disabled="{{!canSubmit}}" loading="{{loading}}">发布</button>
  </view>
</view>
