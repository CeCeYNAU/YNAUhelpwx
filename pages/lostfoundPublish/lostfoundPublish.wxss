.publish-page { min-height: 100vh; background: var(--bg); }

.page-header {
  background: linear-gradient(135deg, #2196F3, #42A5F5);
  color: #fff; padding: 48rpx 28rpx 36rpx;
}

.page-title { font-size: 36rpx; font-weight: 800; color: #fff; }

.form-wrap { padding: 28rpx; }
.form-item { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; font-weight: 600; color: var(--ink); margin-bottom: 12rpx; display: block; }
.form-input { background: var(--white); border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; }
.form-textarea { background: var(--white); border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; min-height: 160rpx; }

.type-row { display: flex; gap: 16rpx; }
.type-btn { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 24rpx; font-size: 26rpx; color: var(--ink-light); background: var(--white); font-weight: 500; }
.type-btn.active { background: #2196F3; color: #fff; font-weight: 600; }

.submit-wrap { padding: 40rpx 28rpx; }
