<view class="page publish-page">
  <view class="page-header">
    <text class="page-title">发布失物招领</text>
  </view>

  <view class="form-wrap">
    <view class="form-item">
      <text class="form-label">类型</text>
      <view class="type-row">
        <view class="type-btn {{type === 'lost' ? 'active' : ''}}" bindtap="setType" data-t="lost">寻物启事</view>
        <view class="type-btn {{type === 'found' ? 'active' : ''}}" bindtap="setType" data-t="found">失物招领</view>
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">标题</text>
      <input class="form-input" placeholder="如：丢失校园卡" value="{{title}}" bindinput="onTitle" />
    </view>
    <view class="form-item">
      <text class="form-label">详情</text>
      <textarea class="form-textarea" placeholder="请描述物品特征、丢失/拾取时间地点等" value="{{desc}}" bindinput="onDesc" maxlength="200" />
    </view>
    <view class="form-item">
      <text class="form-label">地点</text>
      <input class="form-input" placeholder="丢失/拾取地点" value="{{location}}" bindinput="onLocation" />
    </view>
    <view class="form-item">
      <text class="form-label">联系方式</text>
      <input class="form-input" placeholder="手机号或微信号" value="{{contact}}" bindinput="onContact" />
    </view>
  </view>

  <view class="submit-wrap">
    <button class="btn-primary" bindtap="submit">发布</button>
  </view>
</view>
