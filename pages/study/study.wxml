<view class="page">
  <view class="page-header">
    <view>
      <text class="page-title">学业共享</text>
      <text class="page-subtitle">分享学习资料与经验</text>
    </view>
    <view class="publish-btn" bindtap="goPublish">
      <text>分享</text>
    </view>
  </view>

  <view class="search-bar">
    <input class="search-input" placeholder="搜索课程名、教师名..." value="{{searchKey}}" bindinput="onSearch" />
  </view>

  <view class="filter-tabs">
    <scroll-view class="tab-scroll" scroll-x enhanced="true" show-scrollbar="false">
      <view class="tab {{activeTab === 'latest' ? 'active' : ''}}" bindtap="onCat" data-tab="latest">
        <text>最新</text>
      </view>
      <view class="tab {{activeTab === 'hot' ? 'active' : ''}}" bindtap="onCat" data-tab="hot">
        <text>热门</text>
      </view>
    </scroll-view>
  </view>

  <view class="study-list">
    <view class="study-card glass-card" wx:for="{{studyList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="card-header">
        <view class="card-tag tag-{{item._typeTag}}">{{item._typeText}}</view>
        <view class="card-views">
          <text>👁️ {{item._views}}</text>
        </view>
      </view>
      <view class="card-title">{{item.title}}</view>
      <view class="card-meta">
        <text wx:if="{{item._course}}">📖 {{item._course}}</text>
        <text wx:if="{{item._teacher}}"> | {{item._teacher}}</text>
      </view>
      <view class="card-footer">
        <text class="card-author">{{item._author}}</text>
        <text class="card-time">{{item.time}}</text>
        <view class="delete-btn" wx:if="{{item.authorId === currentStudentId}}" catchtap="onDelete" data-id="{{item.id}}">
          <text>删除</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{studyList.length === 0}}">
      <text class="empty-icon">📚</text>
      <text class="empty-text">还没有学习资料，快来分享吧</text>
    </view>
  </view>
</view>
