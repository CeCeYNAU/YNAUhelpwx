.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF3E0 0%, #F5F5F5 100%);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.page-header {
  background: linear-gradient(135deg, rgba(233,30,99,0.95) 0%, rgba(244,143,187,0.9) 60%, rgba(248,187,208,0.85) 100%);
  padding: 48rpx 32rpx 24rpx;
  position: relative;
  overflow: hidden;
}

/* Abstract geometric background overlay */
.page-header::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url('/images/ui-images/樱花防御塔.png');
  background-size: cover;
  background-position: center;
  opacity: 0.15;
  z-index: 0;
  animation: bgZoom 26s ease-in-out infinite alternate;
}

@keyframes bgZoom {
  from { transform: scale(1); }
  to { transform: scale(1.08); }
}

.page-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  display: block;
  position: relative;
  z-index: 1;
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 6rpx;
  display: block;
  position: relative;
  z-index: 1;
}

.publish-btn {
  padding: 14rpx 32rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  position: relative;
  z-index: 1;
  transition: all 0.2s;
}

.publish-btn:active {
  background: rgba(255,255,255,0.5);
}

.filter-tabs {
  padding: 16rpx 24rpx;
  background: rgba(255,255,255,0.5);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.tab-scroll {
  white-space: nowrap;
  overflow-x: auto;
}

.tab-scroll::-webkit-scrollbar { display: none; }

.tab {
  display: inline-block;
  margin-right: 12rpx;
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: rgba(255,255,255,0.6);
  color: var(--ink-light);
  transition: all 0.2s;
}

.tab:active {
  transform: scale(0.95);
}

.tab.active {
  background: #E91E63;
  color: #fff;
}

.post-list {
  padding: 16rpx 24rpx;
}

.post-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.post-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.author-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  display: block;
}

.post-time {
  font-size: 20rpx;
  color: var(--gray);
  display: block;
  margin-top: 2rpx;
}

.post-tag {
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.tag-blue { background: #E3F2FD; color: #1565C0; }
.tag-red { background: #FFEBEE; color: #C62828; }
.tag-green { background: #E8F5E9; color: #2E7D32; }
.tag-gold { background: #FFF8E1; color: #D4A017; }

.post-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.post-content {
  font-size: 24rpx;
  color: var(--ink-light);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 16rpx;
}

.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(0,0,0,0.04);
}

.post-stat {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--gray);
}

.stat-icon { font-size: 24rpx; }
.stat-divider { margin: 0 4rpx; }

.delete-btn {
  padding: 6rpx 16rpx;
  background: #FFEBEE;
  color: #C62828;
  border-radius: 12rpx;
  font-size: 20rpx;
}

.delete-btn:active {
  background: #C62828;
  color: #fff;
}
