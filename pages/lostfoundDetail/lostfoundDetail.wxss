.lf-detail-page .detail-header { color: #fff; padding: 40rpx 28rpx; }
.lf-detail-page .detail-title { font-size: 36rpx; font-weight: 800; color: #fff; display: block; margin-bottom: 10rpx; }
.lf-detail-page .detail-time { font-size: 24rpx; color: rgba(255,255,255,0.8); }

.detail-body { padding: 28rpx; }
.detail-text { font-size: 28rpx; color: var(--ink); line-height: 1.8; display: block; margin-bottom: 24rpx; }
.detail-info { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 28rpx; }
.info-item { font-size: 26rpx; color: var(--ink-light); }

.call-btn { background: linear-gradient(135deg, #2196F3, #42A5F5); color: #fff; border-radius: 40rpx; font-size: 28rpx; font-weight: 600; padding: 20rpx; margin-top: 20rpx; }
.call-btn::after { border: none; }

.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 100rpx 40rpx; }
.empty-icon-img { width: 120rpx; height: 120rpx; margin-bottom: 24rpx; opacity: 0.5; }
.empty-text { font-size: 28rpx; color: var(--gray); }
