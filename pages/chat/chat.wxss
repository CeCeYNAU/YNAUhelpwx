.chat-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F5E9 0%, #F5F5F5 100%);
  display: flex;
  flex-direction: column;
}

.chat-scroll { flex: 1; padding: 24rpx; }

.msg-row { display: flex; margin-bottom: 24rpx; animation: slideUp 0.3s ease; }
.msg-row.right { flex-direction: row-reverse; }

.msg-avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; flex-shrink: 0; margin: 0 12rpx;
  overflow: hidden;
}
.ai-avatar { background: linear-gradient(135deg, var(--green), var(--green-light)); padding: 8rpx; }
.user-avatar { background: var(--green-bg); border: 2rpx solid var(--green-soft); padding: 8rpx; }
.avatar-img { width: 100%; height: 100%; }

.msg-bubble {
  max-width: 70%; padding: 20rpx 24rpx; border-radius: 20rpx;
  font-size: 28rpx; line-height: 1.6;
  transition: transform 0.2s;
}
.msg-bubble:active { transform: scale(0.98); }

.user-bubble {
  background: linear-gradient(135deg, var(--green), var(--green-light));
  color: #fff; border-bottom-right-radius: 6rpx;
  box-shadow: 0 4rpx 12rpx rgba(46,125,50,0.2);
}
.ai-bubble {
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: var(--ink);
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 1rpx solid rgba(255,255,255,0.5);
}
.msg-text { white-space: pre-wrap; }

.quick-questions {
  padding: 12rpx 24rpx;
  background: rgba(255,255,255,0.5);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.quick-scroll {
  white-space: nowrap;
  overflow-x: auto;
}

.quick-scroll::-webkit-scrollbar { display: none; }

.quick-q {
  display: inline-block;
  margin-right: 12rpx;
  background: rgba(255,255,255,0.7);
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: var(--green);
  border: 1rpx solid rgba(46,125,50,0.15);
  transition: all 0.2s;
}

.quick-q:active {
  background: var(--green);
  color: var(--white);
  transform: scale(0.95);
}

.input-area {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(255,255,255,0.8);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-top: 1rpx solid rgba(0,0,0,0.04);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.chat-input {
  flex: 1; height: 72rpx;
  background: rgba(255,255,255,0.8);
  border: 2rpx solid transparent;
  border-radius: 36rpx;
  padding: 0 24rpx; font-size: 28rpx;
  box-sizing: border-box;
  transition: all 0.2s;
}
.chat-input:focus {
  background: #fff;
  border-color: var(--green);
  box-shadow: 0 0 0 4rpx rgba(46,125,50,0.06);
}
.send-btn {
  height: 72rpx; min-width: 120rpx; border-radius: 36rpx;
  background: #ccc; display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: #fff; font-weight: 600;
  transition: all 0.2s;
}
.send-btn.active {
  background: linear-gradient(135deg, var(--green), var(--green-light));
  box-shadow: 0 4rpx 12rpx rgba(46,125,50,0.3);
}
.send-btn.active:active { transform: scale(0.95); }
