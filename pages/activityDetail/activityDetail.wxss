.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFEBEE 0%, #F5F5F5 100%);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.detail-card {
  margin: 24rpx;
  padding: 28rpx;
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.detail-tag {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tag-green { background: #E8F5E9; color: #2E7D32; }
.tag-blue { background: #E3F2FD; color: #1565C0; }
.tag-gold { background: #FFF8E1; color: #D4A017; }
.tag-purple { background: #F3E5F5; color: #7B1FA2; }

.detail-status {
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.status-open { background: #E8F5E9; color: #2E7D32; }
.status-full { background: #FFF8E1; color: #D4A017; }
.status-ended { background: #F5F5F5; color: #999; }

.detail-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.detail-info {
  padding: 20rpx;
  background: rgba(0,0,0,0.02);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.info-icon { font-size: 28rpx; }
.info-text { font-size: 26rpx; color: var(--ink); }

.detail-desc {
  margin-bottom: 20rpx;
}

.desc-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
  margin-bottom: 12rpx;
}

.desc-text {
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.8;
  white-space: pre-wrap;
}

.detail-author {
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0,0,0,0.06);
  font-size: 22rpx;
  color: var(--gray);
  display: flex;
  justify-content: space-between;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-top: 1rpx solid rgba(0,0,0,0.06);
}

.signup-btn {
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #F44336, #EF5350);
  box-shadow: 0 6rpx 20rpx rgba(244, 67, 54, 0.3);
  transition: all 0.2s ease;
}

.signup-btn:active {
  transform: scale(0.96);
}

.signup-btn.signed {
  background: rgba(0,0,0,0.06);
  color: var(--ink-light);
  box-shadow: none;
}

/* Activities list page */
.page-header {
  background: linear-gradient(135deg, rgba(244,67,54,0.95) 0%, rgba(239,83,80,0.9) 60%, rgba(229,115,115,0.85) 100%);
  padding: 48rpx 32rpx 24rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  display: block;
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 6rpx;
  display: block;
}

.publish-btn {
  padding: 14rpx 28rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.filter-tabs {
  padding: 16rpx 24rpx;
  background: rgba(255,255,255,0.5);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.tab-scroll {
  white-space: nowrap;
  overflow-x: auto;
}

.tab-scroll::-webkit-scrollbar { display: none; }

.tab {
  display: inline-block;
  margin-right: 12rpx;
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: rgba(255,255,255,0.6);
  color: var(--ink-light);
  transition: all 0.2s;
}

.tab.active {
  background: #F44336;
  color: #fff;
}

.activity-list { padding: 0 24rpx; }

.activity-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.card-info {
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 0;
  font-size: 22rpx;
  color: var(--ink-light);
}

.info-label { font-size: 24rpx; }

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(0,0,0,0.04);
  font-size: 20rpx;
  color: var(--gray);
}

.card-author { font-weight: 500; }

.delete-btn {
  padding: 4rpx 12rpx;
  background: #FFEBEE;
  color: #C62828;
  border-radius: 10rpx;
  font-size: 20rpx;
}

.fab {
  position: fixed;
  bottom: 120rpx;
  right: 32rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F44336, #EF5350);
  box-shadow: 0 8rpx 24rpx rgba(244, 67, 54, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.fab-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
}

.fab:active {
  transform: scale(0.9);
}
