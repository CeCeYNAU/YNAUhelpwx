<view class="page course-page">
  <view class="page-header">
    <text class="page-title">我的课表</text>
    <view class="week-nav">
      <view class="nav-btn" bindtap="prevWeek">‹</view>
      <text class="week-label">第 {{currentWeek}} 周</text>
      <view class="nav-btn" bindtap="nextWeek">›</view>
    </view>
  </view>

  <!-- 课程表 -->
  <scroll-view class="table-scroll" scroll-x enhanced="{{true}}">
    <view class="table-wrap">
      <view class="table-head">
        <view class="head-time">时间</view>
        <view class="head-day" wx:for="{{weekDays}}" wx:key="index">{{item}}</view>
      </view>

      <view class="table-row" wx:for="{{timeSlots}}" wx:key="index">
        <view class="row-time">
          <text class="row-time-name">{{item.label}}</text>
          <text class="row-time-val">{{item.time}}</text>
        </view>
        <view class="row-day" wx:for="{{weekDays}}" wx:key="idx" wx:for-index="idx"
          data-weekday="{{idx}}" data-timeslot="{{index}}" bindtap="showAdd">
          <view wx:if="{{courses[idx + '-' + index]}}" class="course-cell"
            style="background: {{courses[idx + '-' + index].color}}">
            <text class="course-name">{{courses[idx + '-' + index].name}}</text>
            <text class="course-loc">{{courses[idx + '-' + index].location}}</text>
            <view class="course-delete" catchtap="deleteCourse" data-id="{{courses[idx + '-' + index]._id}}">×</view>
          </view>
          <view wx:else class="empty-cell">+</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 添加弹窗 -->
  <view class="modal" wx:if="{{showAdd}}" bindtap="hideAdd">
    <view class="modal-box" catchtap="stop">
      <text class="modal-title">添加课程</text>
      <input class="modal-field" placeholder="课程名称" value="{{editCourse.name}}" bindinput="onName" />
      <input class="modal-field" placeholder="教师" value="{{editCourse.teacher}}" bindinput="onTeacher" />
      <input class="modal-field" placeholder="教室" value="{{editCourse.location}}" bindinput="onLocation" />
      <input class="modal-field" placeholder="周次 如1-16" value="{{editCourse.weeks}}" bindinput="onWeeks" />
      <view class="color-row">
        <view class="color-dot {{editCourse.color === c ? 'selected' : ''}}" wx:for="{{colors}}" wx:key="*this"
          style="background: {{c}}" data-color="{{c}}" bindtap="onColor"></view>
      </view>
      <view class="modal-btns">
        <button class="modal-cancel" bindtap="hideAdd">取消</button>
        <button class="modal-confirm" bindtap="saveCourse">保存</button>
      </view>
    </view>
  </view>
</view>
