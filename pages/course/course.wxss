/* 我的课表 - 美化版 */
.course-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.page-header {
  background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 40%, #43A047 70%, #66BB6A 100%);
  padding: 48rpx 32rpx 36rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

/* Abstract geometric background overlay */
.page-header::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url('/images/ui-images/校友会堂.png');
  background-size: cover;
  background-position: center;
  opacity: 0.15;
  z-index: 0;
  animation: bgZoom 24s ease-in-out infinite alternate;
}

@keyframes bgZoom {
  from { transform: scale(1); }
  to { transform: scale(1.08); }
}

.page-title { font-size: 40rpx; font-weight: 800; color: #fff; position: relative; z-index: 1; }

.week-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-top: 16rpx;
}

.nav-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  transition: all 0.2s;
}

.nav-btn:active { background: rgba(255, 255, 255, 0.35); transform: scale(0.9); }

.week-label { font-size: 28rpx; color: #fff; font-weight: 600; }

.table-scroll { width: 100%; white-space: nowrap; }

.table-wrap {
  display: inline-block;
  min-width: 100%;
  padding: 16rpx;
}

.table-head {
  display: flex;
  background: linear-gradient(180deg, var(--green-bg), rgba(232,245,233,0.6));
  border-radius: 16rpx 16rpx 0 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.head-time {
  width: 120rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--green);
  font-weight: 700;
  padding: 16rpx 8rpx;
  flex-shrink: 0;
}

.head-day {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--green);
  font-weight: 700;
  padding: 16rpx 4rpx;
  min-width: 100rpx;
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
  transition: background 0.2s;
}

.table-row:active { background: rgba(46,125,50,0.03); }

.row-time {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 8rpx;
  background: rgba(0,0,0,0.02);
  flex-shrink: 0;
  border-right: 1rpx solid rgba(0,0,0,0.04);
}

.row-time-name { font-size: 22rpx; color: var(--ink); font-weight: 600; }
.row-time-val { font-size: 18rpx; color: var(--gray); margin-top: 4rpx; }

.row-day {
  flex: 1;
  min-width: 100rpx;
  min-height: 100rpx;
  padding: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.course-cell {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
  padding: 12rpx 10rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 90rpx;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
  transition: transform 0.2s;
}

.course-cell:active { transform: scale(0.95); }

.course-delete {
  position: absolute;
  top: 4rpx;
  right: 6rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.25);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.course-delete:active {
  background: rgba(244,67,54,0.7);
}

.course-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-loc {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.85);
}

.empty-cell {
  width: 100%;
  height: 100%;
  border: 2rpx dashed rgba(0,0,0,0.08);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gray);
  font-size: 32rpx;
  min-height: 90rpx;
  transition: all 0.2s;
}

.empty-cell:active {
  background: var(--green-bg);
  border-color: var(--green-soft);
  color: var(--green);
}

/* 模态框 - 液态玻璃 */
.modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  animation: fadeIn 0.2s ease;
}

.modal-box {
  width: 85%;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: 24rpx;
  padding: 36rpx 28rpx 28rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255,255,255,0.6);
  animation: scaleIn 0.3s ease;
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
  text-align: center;
  margin-bottom: 28rpx;
}

.modal-field {
  width: 100%;
  background: rgba(0,0,0,0.03);
  border: 2rpx solid rgba(0,0,0,0.06);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.modal-field:focus {
  background: #fff;
  border-color: var(--green);
  box-shadow: 0 0 0 4rpx rgba(46, 125, 50, 0.08);
}

.color-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
  justify-content: center;
}

.color-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  transition: transform 0.2s ease;
}

.color-dot.selected {
  border-color: var(--ink);
  transform: scale(1.15);
}

.color-dot:active {
  transform: scale(0.9);
}

.modal-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.modal-cancel, .modal-confirm {
  flex: 1;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 18rpx;
}

.modal-cancel { background: rgba(0,0,0,0.04); color: var(--gray); }
.modal-cancel::after { border: none; }

.modal-confirm {
  background: linear-gradient(135deg, var(--green), var(--green-light));
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(46, 125, 50, 0.3);
}

.modal-confirm::after { border: none; }

.modal-confirm:active {
  transform: scale(0.96);
}
