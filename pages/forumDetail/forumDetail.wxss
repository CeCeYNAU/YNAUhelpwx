.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF3E0 0%, #F5F5F5 100%);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.post-card {
  margin: 24rpx;
  padding: 28rpx;
}

.post-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.author-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  display: block;
}

.post-time {
  font-size: 22rpx;
  color: var(--gray);
  display: block;
  margin-top: 2rpx;
}

.post-tag {
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.tag-blue { background: #E3F2FD; color: #1565C0; }
.tag-red { background: #FFEBEE; color: #C62828; }
.tag-green { background: #E8F5E9; color: #2E7D32; }
.tag-gold { background: #FFF8E1; color: #D4A017; }

.post-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.post-body {
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.8;
  margin-bottom: 20rpx;
  white-space: pre-wrap;
}

.post-stats {
  display: flex;
  gap: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0,0,0,0.06);
}

.stat-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(0,0,0,0.03);
  font-size: 24rpx;
  color: var(--ink-light);
}

.stat-btn:active {
  background: rgba(233,30,99,0.1);
  color: #E91E63;
}

.stat-icon { font-size: 28rpx; }

/* 评论区 */
.comment-section {
  padding: 0 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  padding: 16rpx 0;
  display: block;
}

.comment-list {
  padding-bottom: 16rpx;
}

.comment-card {
  margin-bottom: 12rpx;
  padding: 20rpx;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.comment-author {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
}

.comment-time {
  font-size: 20rpx;
  color: var(--gray);
}

.comment-body {
  font-size: 24rpx;
  color: var(--ink);
  line-height: 1.6;
}

/* 评论输入 */
.comment-input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-top: 1rpx solid rgba(0,0,0,0.06);
  z-index: 100;
}

.comment-input {
  flex: 1;
  height: 68rpx;
  background: rgba(0,0,0,0.04);
  border-radius: 34rpx;
  padding: 0 22rpx;
  font-size: 26rpx;
}

.comment-send {
  height: 68rpx;
  min-width: 110rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #E91E63, #F48FB1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

.comment-send:active {
  transform: scale(0.95);
}
