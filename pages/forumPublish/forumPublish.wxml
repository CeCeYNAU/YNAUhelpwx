<view class="page">
  <view class="page-header">
    <text class="page-title">发布帖子</text>
    <text class="page-subtitle">分享你的想法</text>
  </view>

  <view class="form-container">
    <view class="form-section">
      <text class="section-label">标题</text>
      <input class="form-input" placeholder="请输入帖子标题" value="{{title}}" bindinput="onTitleInput" maxlength="30" />
      <text class="char-count">{{title.length}}/30</text>
    </view>

    <view class="form-section">
      <text class="section-label">分类</text>
      <picker mode="selector" range="{{categories}}" bindchange="onCategoryChange">
        <view class="form-picker">{{category}}</view>
      </picker>
    </view>

    <view class="form-section">
      <text class="section-label">内容</text>
      <textarea class="form-textarea" placeholder="分享你的想法...（至少10字）" value="{{content}}" bindinput="onContentInput" maxlength="500" auto-height />
      <text class="char-count">{{content.length}}/500</text>
    </view>

    <button class="btn-submit" bindtap="doSubmit" disabled="{{!canSubmit}}" loading="{{loading}}">发布</button>
  </view>
</view>
