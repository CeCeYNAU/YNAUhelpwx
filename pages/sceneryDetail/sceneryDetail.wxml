<view class="page">
  <view class="detail-container" wx:if="{{item}}">
    <image class="detail-image" src="{{item.imagePath}}" mode="widthFix" bindtap="previewImage" />
    <view class="detail-info">
      <text class="detail-title">{{item.title}}</text>
      <view class="detail-meta">
        <image class="meta-avatar" src="{{item._authorAvatar}}" mode="aspectFill" />
        <text class="meta-name">{{item._authorName}}</text>
        <text class="meta-views">{{item._views}} 浏览</text>
        <text class="meta-time">{{item.time}}</text>
      </view>
      <text class="detail-desc" wx:if="{{item.description}}">{{item.description}}</text>
    </view>
  </view>
  <view class="empty" wx:else>
    <text>加载中...</text>
  </view>
</view>
