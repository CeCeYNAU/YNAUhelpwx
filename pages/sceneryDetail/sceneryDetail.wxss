.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.detail-container {
  background: #fff;
}

.detail-image {
  width: 100%;
  display: block;
}

.detail-info {
  padding: 24rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.detail-meta {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.meta-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.meta-name {
  font-size: 26rpx;
  color: #666;
  margin-right: 16rpx;
}

.meta-views,
.meta-time {
  font-size: 22rpx;
  color: #999;
  margin-left: auto;
}

.meta-time {
  margin-left: 16rpx;
}

.detail-desc {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  display: block;
}

.empty {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
  color: #999;
  font-size: 28rpx;
}
