<view class="page news-page">
  <view class="page-header">
    <text class="page-title">校园资讯</text>
    <text class="page-subtitle">最新校园新闻与公告</text>
  </view>

  <!-- 分类 -->
  <scroll-view class="category-bar" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="cat-item {{activeCat === index ? 'active' : ''}}" wx:for="{{categories}}" wx:key="*this" bindtap="onCat" data-index="{{index}}">
      <text>{{item}}</text>
    </view>
  </scroll-view>

  <!-- 搜索 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索新闻..." value="{{searchKey}}" bindinput="onSearch" />
  </view>

  <!-- 列表 -->
  <scroll-view class="news-list" scroll-y enhanced="{{true}}">
    <view class="list-wrap">
      <view class="news-item" wx:for="{{showList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="news-tag" wx:if="{{item.tag}}">{{item.tag}}</view>
        <text class="news-title">{{item.title}}</text>
        <text class="news-desc">{{item.content}}</text>
        <text class="news-time">{{item.time}}</text>
      </view>

      <view class="empty-state" wx:if="{{showList.length === 0}}">
        <text class="empty-icon">📰</text>
        <text class="empty-text">暂无相关资讯</text>
      </view>
    </view>
  </scroll-view>
</view>
