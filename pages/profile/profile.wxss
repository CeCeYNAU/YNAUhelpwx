/* 个人中心 - Material Design 3 + Material You */

.profile-page {
  min-height: 100vh;
  background: var(--md-background);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ========== 用户信息卡片 - Material You 大卡片 ========== */
.user-card {
  margin: 24rpx 24rpx 0;
  border-radius: var(--radius-xxl);
  overflow: hidden;
  background: var(--md-surface-container-low);
  box-shadow: var(--elevation-2);
  border: 1rpx solid var(--md-outline-variant);
  animation: cardEnter 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.user-bg {
  height: 220rpx;
  background: linear-gradient(135deg, var(--md-primary) 0%, var(--md-primary-container) 50%, var(--md-tertiary-container) 100%);
  position: relative;
  overflow: hidden;
}

/* Abstract geometric background */
.user-bg::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url('/images/ui-images/校友会堂.png');
  background-size: cover;
  background-position: center;
  opacity: 0.2;
  z-index: 0;
  animation: bgZoom 22s ease-in-out infinite alternate;
}

/* Floating decorative circles on top */
.user-bg .decor-circle-1 {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  animation: morphing 10s ease-in-out infinite;
  z-index: 1;
}

.user-bg .decor-circle-2 {
  position: absolute;
  bottom: -60rpx;
  left: 60rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  animation: float 8s ease-in-out infinite reverse;
  z-index: 1;
}

.user-info {
  display: flex;
  align-items: flex-end;
  padding: 0 32rpx 32rpx;
  gap: 24rpx;
  position: relative;
  margin-top: -56rpx;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--radius-full);
  border: 4rpx solid var(--md-surface);
  box-shadow: var(--elevation-3);
  background: var(--md-surface-container-high);
  flex-shrink: 0;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.user-avatar:active {
  transform: scale(0.9) rotate(10deg);
}

.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-bottom: 8rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--md-on-surface);
  letter-spacing: -0.5rpx;
}

.user-id {
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
  font-weight: 500;
}

.user-college {
  font-size: 24rpx;
  color: var(--md-primary);
  font-weight: 600;
  margin-top: 4rpx;
}

.edit-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 10rpx 24rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
  z-index: 2;
  transition: all 0.2s ease;
  letter-spacing: 0.3rpx;
}

.edit-btn:active {
  background: rgba(255, 255, 255, 0.4);
  transform: scale(0.95);
}

.guest-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  gap: 12rpx;
}

.guest-text {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--md-primary);
  letter-spacing: -0.5rpx;
}

.guest-sub {
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
}

/* ========== 统计栏 - Material You Chips ========== */
.stats-bar {
  display: flex;
  background: var(--md-surface-container);
  margin: 24rpx 24rpx;
  border-radius: var(--radius-xl);
  padding: 28rpx 0;
  box-shadow: var(--elevation-1);
  border: 1rpx solid var(--md-outline-variant);
  animation: cardEnter 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.1s backwards;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
  transition: all 0.2s ease;
}

.stat:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  bottom: 20%;
  width: 1rpx;
  background: var(--md-outline-variant);
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--md-primary);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  letter-spacing: -1rpx;
}

.stat:active .stat-num {
  transform: scale(1.15);
  color: var(--md-tertiary);
}

.stat-label {
  font-size: 22rpx;
  color: var(--md-on-surface-variant);
  font-weight: 500;
}

/* ========== 菜单列表 - Material You List ========== */
.menu-section {
  background: var(--md-surface-container-low);
  margin: 24rpx 24rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--elevation-1);
  border: 1rpx solid var(--md-outline-variant);
  animation: cardEnter 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.2s backwards;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid var(--md-outline-variant);
  position: relative;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.menu-item:last-child { border-bottom: none; }

.menu-item::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--md-primary-container);
  opacity: 0;
  transition: opacity 0.2s ease;
}

.menu-item:active::before {
  opacity: 1;
}

.menu-item:active {
  transform: translateX(8rpx);
}

.menu-icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.1));
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.menu-item:active .menu-icon {
  transform: scale(1.1) rotate(-5deg);
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
  color: var(--md-on-surface);
  font-weight: 600;
  position: relative;
  z-index: 1;
  letter-spacing: -0.3rpx;
}

.menu-arrow {
  font-size: 28rpx;
  color: var(--md-outline);
  position: relative;
  z-index: 1;
  transition: all 0.2s ease;
}

.menu-item:active .menu-arrow {
  color: var(--md-primary);
  transform: translateX(4rpx);
}

/* ========== 退出登录 - Material You Button ========== */
.logout-wrap {
  margin: 24rpx 24rpx;
  animation: cardEnter 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.3s backwards;
}

.logout-btn {
  background: var(--md-error-container);
  color: var(--md-on-error-container);
  border: none;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 700;
  padding: 24rpx;
  box-shadow: var(--elevation-1);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  letter-spacing: 0.5rpx;
}

.logout-btn::after { border: none; }

.logout-btn:active {
  background: var(--md-error);
  color: var(--md-on-error);
  box-shadow: var(--elevation-2);
  transform: scale(0.96);
}

/* ========== 编辑弹窗 - Material Dialog ========== */
.modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  animation: fadeIn 0.2s ease;
}

.modal-box {
  width: 85%;
  max-width: 600rpx;
  background: var(--md-surface-container-high);
  border-radius: var(--radius-xxl);
  padding: 40rpx 32rpx 32rpx;
  box-shadow: var(--elevation-5);
  border: 1rpx solid var(--md-outline-variant);
  animation: scaleIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.9) translateY(20rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.modal-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--md-on-surface);
  display: block;
  text-align: center;
  margin-bottom: 32rpx;
  letter-spacing: -0.5rpx;
}

.modal-input {
  margin-bottom: 24rpx;
}

.modal-label {
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
  display: block;
  margin-bottom: 10rpx;
  font-weight: 600;
  letter-spacing: 0.3rpx;
}

.modal-field {
  background: var(--md-surface);
  border: 2rpx solid var(--md-outline-variant);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  color: var(--md-on-surface);
  width: 100%;
  box-sizing: border-box;
}

.modal-field:focus {
  background: var(--md-surface-container-low);
  border-color: var(--md-primary);
  box-shadow: 0 0 0 6rpx rgba(46, 125, 50, 0.1);
  outline: none;
}

.modal-field::placeholder {
  color: var(--md-outline);
}

.modal-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.modal-cancel, .modal-confirm {
  flex: 1;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 700;
  padding: 22rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  letter-spacing: 0.5rpx;
}

.modal-cancel {
  background: var(--md-surface-variant);
  color: var(--md-on-surface-variant);
  border: none;
}

.modal-cancel::after { border: none; }

.modal-cancel:active {
  background: var(--md-outline-variant);
  transform: scale(0.96);
}

.modal-confirm {
  background: var(--md-primary);
  color: var(--md-on-primary);
  border: none;
  box-shadow: var(--elevation-2);
}

.modal-confirm::after { border: none; }

.modal-confirm:active {
  transform: scale(0.96);
  box-shadow: var(--elevation-1);
}

/* ========== 额外创意元素 ========== */

@keyframes bgZoom {
  from { transform: scale(1); }
  to { transform: scale(1.08); }
}

/* 浮动装饰粒子 */
.profile-page::before {
  content: '🌱';
  position: fixed;
  top: 15%;
  right: 10%;
  font-size: 48rpx;
  opacity: 0.15;
  animation: float 6s ease-in-out infinite;
  pointer-events: none;
  z-index: 0;
}

.profile-page::after {
  content: '🍃';
  position: fixed;
  bottom: 25%;
  left: 8%;
  font-size: 40rpx;
  opacity: 0.12;
  animation: float 8s ease-in-out infinite reverse;
  pointer-events: none;
  z-index: 0;
}
