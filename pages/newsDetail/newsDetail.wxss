.detail-page { min-height: 100vh; background: var(--bg); padding-bottom: 40rpx; }

.detail-header {
  background: var(--white); padding: 40rpx 28rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.detail-tag {
  display: inline-block; padding: 4rpx 12rpx; border-radius: 8rpx;
  font-size: 20rpx; color: #fff; background: var(--green);
  font-weight: 600; margin-bottom: 12rpx;
}

.detail-title { font-size: 36rpx; font-weight: 800; color: var(--ink); display: block; margin-bottom: 12rpx; }
.detail-time { font-size: 24rpx; color: var(--gray); }

.detail-body { padding: 28rpx; }
.detail-text { font-size: 30rpx; color: var(--ink); line-height: 1.8; display: block; white-space: pre-wrap; }

.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 100rpx 40rpx; }
.empty-icon-img { width: 120rpx; height: 120rpx; margin-bottom: 24rpx; opacity: 0.5; }
.empty-text { font-size: 28rpx; color: var(--gray); }
